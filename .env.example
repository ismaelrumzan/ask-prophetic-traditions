# Neon Postgres (Vercel Marketplace integration)
DATABASE_URL=

# Embeddings — Qwen3-Embedding-0.6B (1024 dims; must match at ingest and query time)
# Provider: ollama (local seed + dev) | gateway (Vercel prod — verify parity with Ollama first)
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
GATEWAY_EMBEDDING_MODEL=alibaba/qwen3-embedding-0.6b
# EMBED_MAX_CHARS=12000
# EMBEDDING_DIMENSION=1024
# OLLAMA_EMBED_BATCH=32

# Chat generation — Vercel AI Gateway (OIDC from `vercel env pull .env.local`)
VERCEL_OIDC_TOKEN=
# CHAT_MODEL=openai/gpt-4o-mini

# Retrieval — hybrid FTS + pgvector (default on after `npm run db:migrate:hybrid`)
# HYBRID_SEARCH=true
# HYBRID_RRF_K=60
# HYBRID_CANDIDATE_LIMIT=50
# RETRIEVAL_TOP_K=8
# RETRIEVAL_RERANK=false
# RERANK_MODEL=cohere/rerank-v3.5

# Upstash Redis (optional locally; recommended in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
